*PPD-Adobe: "4.3"
*FormatVersion: "4.3"
*FileVersion: "1.0"
*cupsVersion: "2.0"
*LanguageEncoding: ISOLatin1
*LanguageVersion: English
*ModelName: "CatPrint"
*ShortNickName: "CatPrint"
*NickName: "CatPrint (BLE bridge via NAS)"
*Product: "(CatPrint)"
*Manufacturer: "CatPrint"
*ColorDevice: False
*DefaultColorSpace: Gray
*FileSystem: False
*Throughput: "8"

*% The client (iOS/macOS) rasterizes to image/urf; the NAS passes the URF
*% document through unchanged to the catbridge backend. No CUPS filters run.
*cupsFilter2: "image/urf image/urf 10 -"
*cupsFilter: "image/urf 10 -"

*OpenUI *PageSize/Media Size: PickOne
*DefaultPageSize: A6
*PageSize A4/A4: "<</PageSize[595 842]>>setpagedevice"
*PageSize A5/A5: "<</PageSize[420 595]>>setpagedevice"
*PageSize A6/A6: "<</PageSize[297 420]>>setpagedevice"
*CloseUI: *PageSize

*OpenUI *PageRegion/Media Region: PickOne
*DefaultPageRegion: A6
*PageRegion A4/A4: "<</PageSize[595 842]>>setpagedevice"
*PageRegion A5/A5: "<</PageSize[420 595]>>setpagedevice"
*PageRegion A6/A6: "<</PageSize[297 420]>>setpagedevice"
*CloseUI: *PageRegion

*DefaultImageableArea: A6
*ImageableArea A4/A4: "0 0 595 842"
*ImageableArea A5/A5: "0 0 420 595"
*ImageableArea A6/A6: "0 0 297 420"

*DefaultPaperDimension: A6
*PaperDimension A4/A4: "595 842"
*PaperDimension A5/A5: "420 595"
*PaperDimension A6/A6: "297 420"
